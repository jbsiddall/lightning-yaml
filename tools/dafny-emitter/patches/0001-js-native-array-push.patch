diff --git a/Source/IntegrationTests/TestFiles/LitTests/LitTest/javascript-native/IntrinsicArrayPushHarness.js b/Source/IntegrationTests/TestFiles/LitTests/LitTest/javascript-native/IntrinsicArrayPushHarness.js
new file mode 100644
index 0000000..d7cf541
--- /dev/null
+++ b/Source/IntegrationTests/TestFiles/LitTests/LitTest/javascript-native/IntrinsicArrayPushHarness.js
@@ -0,0 +1,151 @@
+const fs = require("fs");
+const assert = require("assert");
+
+let generated = fs.readFileSync(process.argv[2], "utf8");
+const target = process.argv[3];
+const entryPoint = "_dafny.HandleHaltExceptions(() => _module.__default.Main(_dafny.UnicodeFromMainArguments(require('process').argv)));";
+assert(generated.includes(entryPoint), "expected the generated main entry point");
+generated = generated.replace(entryPoint, "return () => _module.__default.Main([]);");
+if (target === "stock") {
+  assert(generated.includes("Adapter.Push("), "stock JavaScript should retain the extern wrapper call");
+} else if (target === "native") {
+  assert(generated.includes("_array_receiver") && generated.includes(".push("), "js-native should emit the staged native push");
+  assert(!generated.includes("Adapter.Push("), "js-native should lower the annotated method call");
+} else {
+  throw new Error(`unknown target: ${target}`);
+}
+if (process.argv[4] === "naive") {
+  const before = generated;
+  generated = generated.replace(
+    /let (_array_receiver\d+) = Adapter\.GetReceiver\(\);\s*let (_array_value\d+) = Adapter\.GetValue\(\);\s*\1\.push\(\2\);/,
+    "Adapter.GetReceiver().push(Adapter.GetValue());");
+  assert.notStrictEqual(generated, before, "the generated simple push should be mutable by this regression check");
+}
+
+function runScenario(options = {}) {
+  const events = [];
+  const receivers = [];
+  const pushedValue = { marker: "value" };
+  let currentReceiver;
+  let entry;
+  let hasReentered = false;
+  const Adapter = Object.freeze({
+    UseReceiver() {
+      events.push("condition");
+      return true;
+    },
+    GetReceiver() {
+      events.push("receiver");
+      if ("throwReceiver" in options) throw options.throwReceiver;
+      let target;
+      if (options.subclassPush) {
+        class PushArray extends Array {
+          push(value) {
+            events.push(this === currentReceiver ? "override-this" : "bad-this");
+            return super.push(value);
+          }
+        }
+        target = new PushArray();
+      } else {
+        target = [];
+      }
+      currentReceiver = target;
+      if (options.proxyReceiver) {
+        currentReceiver = new Proxy(target, {
+          get(object, property, receiver) {
+            if (property === "push") events.push("proxy-get");
+            return Reflect.get(object, property, receiver);
+          },
+          set(object, property, value, receiver) {
+            if (property === "0") events.push("proxy-set");
+            return Reflect.set(object, property, value, receiver);
+          }
+        });
+      }
+      receivers.push({ target, receiver: currentReceiver });
+      return currentReceiver;
+    },
+    GetValue() {
+      events.push("value");
+      if ("throwValue" in options) throw options.throwValue;
+      const target = currentReceiver;
+      if (!options.subclassPush) {
+        Object.defineProperty(target, "push", {
+          configurable: true,
+          get() {
+            events.push("lookup");
+            if ("throwLookup" in options) throw options.throwLookup;
+            return function (value) {
+              events.push(this === target ? "call-this" : "bad-this");
+              return Array.prototype.push.call(this, value);
+            };
+          }
+        });
+      }
+      if (options.reenter && !hasReentered) {
+        hasReentered = true;
+        entry();
+      }
+      return pushedValue;
+    },
+    Push(target, value) {
+      return target.push(value);
+    },
+    Keep() {
+      events.push("retained");
+    }
+  });
+  const _dafny = {
+    HandleHaltExceptions(run) { run(); },
+    UnicodeFromMainArguments() { return []; }
+  };
+  entry = new Function("Adapter", "_dafny", generated)(Adapter, _dafny);
+  try {
+    entry();
+    return { events, receivers, pushedValue, didThrow: false };
+  } catch (thrown) {
+    return { events, receivers, pushedValue, didThrow: true, thrown };
+  }
+}
+
+const normal = runScenario();
+assert.deepStrictEqual(normal.events, [
+  "condition", "receiver", "value", "lookup", "call-this",
+  "receiver", "value", "lookup", "call-this", "retained"
+]);
+assert.deepStrictEqual(normal.receivers.map(({ target }) => target.length), [1, 1]);
+assert(normal.receivers.every(({ target }) => target[0] === normal.pushedValue));
+
+for (const payload of [{ marker: "argument" }, undefined]) {
+  const receiverThrow = runScenario({ throwReceiver: payload });
+  assert(receiverThrow.didThrow);
+  assert.strictEqual(receiverThrow.thrown, payload);
+  assert.deepStrictEqual(receiverThrow.events, ["condition", "receiver"]);
+
+  const valueThrow = runScenario({ throwValue: payload });
+  assert(valueThrow.didThrow);
+  assert.strictEqual(valueThrow.thrown, payload);
+  assert.deepStrictEqual(valueThrow.events, ["condition", "receiver", "value"]);
+
+  const lookupThrow = runScenario({ throwLookup: payload });
+  assert(lookupThrow.didThrow);
+  assert.strictEqual(lookupThrow.thrown, payload);
+  assert.deepStrictEqual(lookupThrow.events, ["condition", "receiver", "value", "lookup"]);
+}
+
+const proxy = runScenario({ proxyReceiver: true });
+assert(proxy.events.includes("proxy-get"));
+assert(proxy.events.includes("proxy-set"));
+assert(proxy.events.includes("call-this"));
+assert(proxy.receivers.every(({ target }) => target.length === 1));
+
+const subclass = runScenario({ subclassPush: true });
+assert(subclass.events.includes("override-this"));
+assert(subclass.receivers.every(({ target }) => target.length === 1));
+
+const reentrant = runScenario({ reenter: true });
+assert.strictEqual(reentrant.receivers.length, 4);
+assert(reentrant.receivers.every(({ target }) => target.length === 1));
+assert.strictEqual(reentrant.receivers[0].target === reentrant.receivers[1].target, false);
+
+process.stdout.write("intrinsic differential passed\n");
diff --git a/Source/IntegrationTests/TestFiles/LitTests/LitTest/javascript-native/InvalidArrayPushIntrinsic.dfy b/Source/IntegrationTests/TestFiles/LitTests/LitTest/javascript-native/InvalidArrayPushIntrinsic.dfy
new file mode 100644
index 0000000..ade9db8
--- /dev/null
+++ b/Source/IntegrationTests/TestFiles/LitTests/LitTest/javascript-native/InvalidArrayPushIntrinsic.dfy
@@ -0,0 +1,17 @@
+// NONUNIFORM: checks validation specific to the experimental js-native backend
+// RUN: ! %translate js-native %trargs --no-verify --output "%t.js" "%s" > /dev/null
+
+class Host {
+  static method {:extern} {:jsIntrinsic "unknown"} Unknown(receiver: array<int>, value: int)
+  static method {:extern} {:jsIntrinsic 1} Malformed(receiver: array<int>, value: int)
+  method {:extern} {:jsIntrinsic "arrayPush"} Instance(receiver: array<int>, value: int)
+  static method {:jsIntrinsic "arrayPush"} NonExtern(receiver: array<int>, value: int) {}
+  static method {:extern} {:jsIntrinsic "arrayPush"} WithOutput(receiver: array<int>, value: int) returns (result: int)
+  static method {:extern} {:jsIntrinsic "arrayPush"} Generic<T>(receiver: array<int>, value: T)
+}
+
+class GenericHost<T> {
+  static method {:extern} {:jsIntrinsic "arrayPush"} GenericClass(receiver: array<int>, value: int)
+}
+
+method Main() {}
