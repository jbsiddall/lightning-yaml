diff --git a/Source/DafnyCore/Backends/JavaScript/JavaScriptNativeBackend.cs b/Source/DafnyCore/Backends/JavaScript/JavaScriptNativeBackend.cs
new file mode 100644
index 0000000..b172a98
--- /dev/null
+++ b/Source/DafnyCore/Backends/JavaScript/JavaScriptNativeBackend.cs
@@ -0,0 +1,99 @@
+using System.Collections.Generic;
+using System.Linq;
+using Microsoft.Dafny;
+
+namespace Microsoft.Dafny.Compilers;
+
+public sealed class JavaScriptNativeBackend : JavaScriptBackend {
+  public JavaScriptNativeBackend(DafnyOptions options) : base(options) { }
+
+  public override string TargetId => "js-native";
+  public override string TargetName => "experimental native JavaScript";
+  public override bool IsStable => false;
+
+  protected override SinglePassCodeGenerator CreateCodeGenerator() =>
+    new JavaScriptNativeCodeGenerator(Options, Reporter);
+}
+
+sealed class JavaScriptNativeCodeGenerator : JavaScriptCodeGenerator {
+  const string IntrinsicAttribute = "jsIntrinsic";
+  readonly HashSet<Method> validIntrinsics = new();
+
+  public JavaScriptNativeCodeGenerator(DafnyOptions options, ErrorReporter reporter) : base(options, reporter) { }
+
+  protected override void EmitHeader(Program program, ConcreteSyntaxTree wr) {
+    foreach (var module in program.CompileModules) {
+      foreach (var declaration in module.TopLevelDecls) {
+        if (Attributes.Find(declaration.Attributes, IntrinsicAttribute) is { }) {
+          Reporter.Error(MessageSource.Compiler, declaration.Origin, "{:jsIntrinsic} is only valid on methods");
+        }
+        if (declaration is not TopLevelDeclWithMembers container) {
+          continue;
+        }
+        foreach (var member in container.Members) {
+          if (Attributes.Find(member.Attributes, IntrinsicAttribute) is { } && member is not Method) {
+            Reporter.Error(MessageSource.Compiler, member.Origin, "{:jsIntrinsic} is only valid on methods");
+          } else if (member is Method method) {
+            ValidateIntrinsic(method);
+          }
+        }
+      }
+    }
+    base.EmitHeader(program, wr);
+  }
+
+  bool ValidateIntrinsic(Method method) {
+    var attributes = method.Attributes?.AsEnumerable().Where(attribute => attribute.Name == IntrinsicAttribute).ToList();
+    if (attributes == null || attributes.Count == 0) {
+      return true;
+    }
+    var validName = attributes.Count == 1 && attributes[0] is UserSuppliedAttributes supplied &&
+      supplied.Args.Count == 1 && supplied.Args[0] is StringLiteralExpr literal && literal.Value is string name && name == "arrayPush";
+    if (!validName) {
+      Reporter.Error(MessageSource.Compiler, method.Origin, "{:jsIntrinsic} must be exactly {:jsIntrinsic \"arrayPush\"}");
+      return false;
+    }
+    if (!method.IsStatic || !method.IsExtern(Options) || method.Ins.Count != 2 || method.Outs.Count != 0 ||
+        method.TypeArgs.Count != 0 || method.EnclosingClass.TypeArgs.Count != 0 || method.Ins.Any(input => input.IsGhost)) {
+      Reporter.Error(MessageSource.Compiler, method.Origin, "{:jsIntrinsic \"arrayPush\"} requires a static extern method with two inputs, no outputs, and no type parameters");
+      return false;
+    }
+    validIntrinsics.Add(method);
+    return true;
+  }
+
+  protected override void TrCallStmt(CallStmt s, string receiverReplacement, ConcreteSyntaxTree wr, ConcreteSyntaxTree wStmts, ConcreteSyntaxTree wStmtsAfterCall) {
+    var attribute = Attributes.Find(s.Method.Attributes, IntrinsicAttribute);
+    if (attribute == null) {
+      base.TrCallStmt(s, receiverReplacement, wr, wStmts, wStmtsAfterCall);
+      return;
+    }
+    if (s.Method is not Method intrinsic) {
+      Reporter.Error(MessageSource.Compiler, s.Origin, "{:jsIntrinsic} is only valid on methods");
+      return;
+    }
+    if (!validIntrinsics.Contains(intrinsic) && !ValidateIntrinsic(intrinsic)) {
+      return;
+    }
+    if (receiverReplacement != null || s.Args.Count != 2 || s.Lhs.Count != 0) {
+      Reporter.Error(MessageSource.Compiler, s.Origin, "arrayPush intrinsic call has an unsupported call context");
+      return;
+    }
+
+    var receiver = ProtectedFreshId("_array_receiver");
+    var value = ProtectedFreshId("_array_value");
+    var block = EmitBlock(wr);
+    for (var index = 0; index < s.Args.Count; index++) {
+      var argument = s.Args[index];
+      var input = s.Method.Original.Ins[index];
+      var expectedType = input.Type.Subst(s.MethodSelect.TypeArgumentSubstitutionsWithParents());
+      var temporary = index == 0 ? receiver : value;
+      var argumentStatements = block.Fork();
+      var argumentWriter = DeclareLocalVar(temporary, expectedType, argument.Origin, block);
+      argumentWriter = EmitCoercionIfNecessary(argument.Type, expectedType, argument.Origin, argumentWriter, input.Type);
+      argumentWriter = EmitDowncastIfNecessary(argument.Type, expectedType, argument.Origin, argumentWriter);
+      EmitExpr(argument, false, argumentWriter, argumentStatements);
+    }
+    block.WriteLine(receiver + ".push(" + value + ");");
+  }
+}
diff --git a/Source/DafnyCore/Backends/JavaScript/NativeTarget.md b/Source/DafnyCore/Backends/JavaScript/NativeTarget.md
new file mode 100644
index 0000000..1feeb62
--- /dev/null
+++ b/Source/DafnyCore/Backends/JavaScript/NativeTarget.md
@@ -0,0 +1,5 @@
+# Experimental native JavaScript target
+
+`js-native` is an unstable target for narrowly annotated host intrinsics. Its first intrinsic is `{:jsIntrinsic "arrayPush"}` on a static extern method with two non-ghost inputs, no outputs, and no type parameters. The annotation is a trusted host contract: the extern binding must be immutable and its lookup must have no observable effects; the implementation must perform `(receiver).push(value)` and discard the result.
+
+The generated call evaluates both arguments once, from left to right, before looking up the receiver's `push` property. That preserves dynamic getters, overrides, proxies, method `this`, and thrown payloads from argument evaluation and property lookup. It does not promise the same engine-generated TypeError wording for every invalid receiver, or the same caller stack frame as the wrapper call it removes.
diff --git a/Source/IntegrationTests/TestFiles/LitTests/LitTest/javascript-native/IntrinsicArrayPush.dfy b/Source/IntegrationTests/TestFiles/LitTests/LitTest/javascript-native/IntrinsicArrayPush.dfy
new file mode 100644
index 0000000..4a2e002
--- /dev/null
+++ b/Source/IntegrationTests/TestFiles/LitTests/LitTest/javascript-native/IntrinsicArrayPush.dfy
@@ -0,0 +1,23 @@
+// NONUNIFORM: exercises the experimental js-native backend and its explicit extern contract
+// RUN: %translate js %trargs --no-verify --allow-warnings --output "%t.stock.js" "%s"
+// RUN: %translate js-native %trargs --no-verify --allow-warnings --output "%t.native.js" "%s"
+// RUN: node "%S/IntrinsicArrayPushHarness.js" "%t.stock.js" stock > "%t.stock.out"
+// RUN: node "%S/IntrinsicArrayPushHarness.js" "%t.native.js" native > "%t.native.out"
+// RUN: %exits-with 1 node "%S/IntrinsicArrayPushHarness.js" "%t.native.js" native naive > /dev/null 2>&1
+// RUN: %diff "%S/IntrinsicArrayPush.expect" "%t.stock.out"
+// RUN: %diff "%S/IntrinsicArrayPush.expect" "%t.native.out"
+
+module {:extern "Adapter"} Host {
+  function {:extern} UseReceiver(): bool
+  function {:extern} GetReceiver(): array<object>
+  function {:extern} GetValue(): object
+  method {:extern} {:jsIntrinsic "arrayPush"} Push(receiver: array<object>, value: object)
+  method {:extern} Keep()
+}
+
+method Main() {
+  Host.Push(if Host.UseReceiver() then Host.GetReceiver() else Host.GetReceiver(),
+    (var value := Host.GetValue(); value));
+  Host.Push(Host.GetReceiver(), Host.GetValue());
+  Host.Keep();
+}
