diff --git a/Source/IntegrationTests/TestFiles/LitTests/LitTest/javascript-native/OutputInitialization.dfy b/Source/IntegrationTests/TestFiles/LitTests/LitTest/javascript-native/OutputInitialization.dfy
new file mode 100644
index 0000000..d5db24f
--- /dev/null
+++ b/Source/IntegrationTests/TestFiles/LitTests/LitTest/javascript-native/OutputInitialization.dfy
@@ -0,0 +1,98 @@
+// NONUNIFORM: checks conservative output initialization elision in js-native against stock JavaScript
+// RUN: %translate js %trargs --no-verify --allow-warnings --output "%t.stock.js" "%s"
+// RUN: %translate js-native %trargs --no-verify --allow-warnings --output "%t.native.js" "%s"
+// RUN: node "%S/OutputInitializationHarness.js" "%t.stock.js" "%t.native.js" "%t.native.out"
+// RUN: %exits-with 1 node "%S/OutputInitializationHarness.js" "%t.stock.js" "%t.native.js" disabled-elision > /dev/null 2>&1
+// RUN: %exits-with 1 node "%S/OutputInitializationHarness.js" "%t.stock.js" "%t.native.js" overbroad-read > /dev/null 2>&1
+// RUN: %diff "%S/OutputInitialization.expect" "%t.native.out"
+
+method AssignBoolean(input: bool) returns (output: bool) {
+  output := input;
+}
+
+method AssignString(input: string) returns (output: string) {
+  output := input;
+}
+
+method ReadBeforeAssign() returns (output: bool) {
+  output := output == false;
+}
+
+method NestedReadBeforeAssign() returns (output: bool) {
+  output := (var value := output; value == false);
+}
+
+method LambdaReadBeforeAssign() returns (output: bool) {
+  output := (x => output == x)(false);
+}
+
+method EarlyReturn(input: bool) returns (output: bool) {
+  if input {
+    return;
+  }
+  output := true;
+}
+
+method LocalBeforeAssign() returns (output: bool) {
+  var local := true;
+  output := local;
+}
+
+method LoopBeforeAssign(input: bool) returns (output: bool) {
+  var condition := input;
+  while condition {
+    output := true;
+    condition := false;
+  }
+  output := false;
+}
+
+method LoopFirst(input: bool) returns (output: bool) {
+  while false {
+    output := input;
+  }
+  output := input;
+}
+
+method MultipleOutputs(input: bool) returns (first: bool, second: bool) {
+  first, second := input, first;
+}
+
+method DependentAssignments(input: bool) returns (output: bool) {
+  output := input;
+  output := !output;
+}
+
+method GhostBeforeAssign(input: bool) returns (output: bool) {
+  ghost var marker := true;
+  output := input;
+}
+
+method ArrayOutput(input: array<int>) returns (output: array<int>) {
+  output := input;
+}
+
+method Main() {
+  var first := AssignBoolean(true);
+  var second := AssignBoolean(false);
+  print first, " ", second, "\n";
+  var read := ReadBeforeAssign();
+  print read, "\n";
+  var nestedRead := NestedReadBeforeAssign();
+  print nestedRead, "\n";
+  var lambdaRead := LambdaReadBeforeAssign();
+  print lambdaRead, "\n";
+  var early := EarlyReturn(true);
+  var late := EarlyReturn(false);
+  print early, " ", late, "\n";
+  var local := LocalBeforeAssign();
+  print local, "\n";
+  var loop := LoopBeforeAssign(true);
+  print loop, "\n";
+  var firstResult, secondResult := MultipleOutputs(true);
+  print firstResult, " ", secondResult, "\n";
+  var dependent := DependentAssignments(true);
+  print dependent, "\n";
+  var ghostResult := GhostBeforeAssign(true);
+  print ghostResult, "\n";
+}
