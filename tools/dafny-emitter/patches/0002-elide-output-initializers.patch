diff --git a/Source/IntegrationTests/TestFiles/LitTests/LitTest/javascript-native/OutputInitializationHarness.js b/Source/IntegrationTests/TestFiles/LitTests/LitTest/javascript-native/OutputInitializationHarness.js
new file mode 100644
