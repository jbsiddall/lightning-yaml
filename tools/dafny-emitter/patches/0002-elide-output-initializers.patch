--- /dev/null
+++ b/Source/IntegrationTests/TestFiles/LitTests/LitTest/javascript-native/OutputInitializationHarness.js
@@ -0,0 +1,78 @@
+const assert = require("assert");
+const fs = require("fs");
+
+// These generated-code mutations prove that the shape and overbroad-read checks can fail.
+function methodSource(source, name) {
+  const start = source.indexOf(`static ${name}(`);
+  assert(start >= 0, `expected method ${name}`);
+  const nextMethod = source.indexOf("\n    static ", start + 1);
+  return source.slice(start, nextMethod < 0 ? source.length : nextMethod);
+}
+
+function replaceMethodDeclaration(source, name, before, after) {
+  const method = methodSource(source, name);
+  assert(method.includes(before), `expected ${name} mutation anchor`);
+  const start = source.indexOf(method);
+  return source.slice(0, start) + method.replace(before, after) + source.slice(start + method.length);
+}
+
+function loadModule(source) {
+  const entryPoint = "_dafny.HandleHaltExceptions(() => _module.__default.Main(_dafny.UnicodeFromMainArguments(require('process').argv)));";
+  assert(source.includes(entryPoint), "expected generated main entry point");
+  source = source.replace(entryPoint, "return _module;");
+  return new Function("require", "_dafny", source)(require, { Seq: { UnicodeFromString: () => "" } });
+}
+
+const stockSource = fs.readFileSync(process.argv[2], "utf8");
+let nativeSource = fs.readFileSync(process.argv[3], "utf8");
+const mutation = ["disabled-elision", "overbroad-read"].includes(process.argv[4]) ? process.argv[4] : null;
+if (mutation === "disabled-elision") {
+  nativeSource = replaceMethodDeclaration(nativeSource, "AssignBoolean", "let output;", "let output = false;");
+} else if (mutation === "overbroad-read") {
+  nativeSource = replaceMethodDeclaration(nativeSource, "NestedReadBeforeAssign", "let output = false;", "let output;");
+  nativeSource = replaceMethodDeclaration(nativeSource, "LambdaReadBeforeAssign", "let output = false;", "let output;");
+}
+const stock = loadModule(stockSource);
+const native = loadModule(nativeSource);
+
+if (mutation !== "overbroad-read") {
+  assert.match(methodSource(stockSource, "AssignBoolean"), /let output = false;/);
+  assert.match(methodSource(nativeSource, "AssignBoolean"), /let output;/);
+  assert.match(methodSource(stockSource, "AssignString"), /let output = _dafny\.Seq\.UnicodeFromString\(""\);/);
+  assert.match(methodSource(nativeSource, "AssignString"), /let output = _dafny\.Seq\.UnicodeFromString\(""\);/);
+  for (const name of ["ReadBeforeAssign", "NestedReadBeforeAssign", "LambdaReadBeforeAssign", "EarlyReturn",
+    "LocalBeforeAssign", "LoopBeforeAssign", "GhostBeforeAssign"]) {
+    assert.match(methodSource(nativeSource, name), /let output = false;/, `${name} must keep its initialization`);
+  }
+  assert.match(methodSource(nativeSource, "LoopFirst"), /let output = false;/);
+  assert.match(methodSource(nativeSource, "MultipleOutputs"), /let first = false;[\s\S]*let second = false;/);
+  assert.match(methodSource(nativeSource, "ArrayOutput"), /let output = \[\];/);
+  assert.match(methodSource(nativeSource, "DependentAssignments"), /let output;/);
+}
+
+const arrayInput = [1, 2];
+const calls = [
+  ["AssignBoolean", [true]],
+  ["AssignBoolean", [false]],
+  ["AssignString", ["sample"]],
+  ["ReadBeforeAssign", []],
+  ["NestedReadBeforeAssign", []],
+  ["LambdaReadBeforeAssign", []],
+  ["EarlyReturn", [true]],
+  ["EarlyReturn", [false]],
+  ["LocalBeforeAssign", []],
+  ["LoopBeforeAssign", [true]],
+  ["LoopFirst", [true]],
+  ["MultipleOutputs", [true]],
+  ["DependentAssignments", [true]],
+  ["GhostBeforeAssign", [true]],
+  ["ArrayOutput", [arrayInput]]
+];
+const stockValues = calls.map(([name, args]) => stock.__default[name](...args));
+const nativeValues = calls.map(([name, args]) => native.__default[name](...args));
+assert.deepStrictEqual(nativeValues, stockValues);
+assert.deepStrictEqual(nativeValues, [true, false, "sample", true, true, true, false, true, true, false, true,
+  [true, false], false, true, arrayInput]);
+if (mutation == null) {
+  fs.writeFileSync(process.argv[4], `${nativeValues.join(" ")}\n`);
+}
