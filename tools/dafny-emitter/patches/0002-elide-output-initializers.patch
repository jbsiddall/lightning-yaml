+  protected override bool CanOmitOutputInitialization(MethodOrConstructor method, Formal output, string defaultValue) {
+    // Type defaults can contain constructors, witnesses, or other effects, so only omit a literal
+    // initializer when the first physical statement directly assigns this output without reading it.
+    if (defaultValue is not ("false" or "true" or "0" or "1" or "\"\"")) {
+      return false;
+    }
+    if (method is not Method { IsTailRecursive: false, Body: BlockStmt body } ||
+        method.Outs.Count(formal => !formal.IsGhost) != 1 ||
+        body.Body.Count == 0 || body.Body[0].IsGhost) {
+      return false;
+    }
+
+    var firstStatement = body.Body[0];
+    var assignment = firstStatement switch {
+      SingleAssignStmt single => single,
+      AssignStatement { Lhss.Count: 1, Rhss.Count: 1, ResolvedStatements.Count: 1 } update
+        when update.ResolvedStatements[0] is SingleAssignStmt single => single,
+      _ => null
+    };
+    if (assignment == null || assignment.IsGhost || assignment.Lhs.Resolved is not IdentifierExpr lhs ||
+        !ReferenceEquals(lhs.Var, output) || assignment.Rhs is not ExprRhs rhs ||
+        rhs.SubStatements.Any() || rhs.Expr.DescendantsAndSelf.Any(expression => expression is StmtExpr) ||
+        rhs.Expr.DescendantsAndSelf.OfType<IdentifierExpr>()
+          .Any(identifier => ReferenceEquals(identifier.Var, output))) {
+      return false;
+    }
+
+    return true;
+  }
+
